#!/usr/bin/env bash
set -euo pipefail

SRC_BRANCH="main"
DEPLOY_BRANCH="gh-pages"
NO_PUSH=""

USAGE_MSG="usage: deploy [-h|--help] [-u|--user] [-s|--src SRC_BRANCH] [-d|--deploy DEPLOY_BRANCH] [--verbose] [--no-push]"

while [[ $# -gt 0 ]]; do
    key="$1"

    case "$key" in
        -h|--help)
        echo "$USAGE_MSG"
        exit 0
        ;;
        -u|--user)
        SRC_BRANCH="source"
        DEPLOY_BRANCH="master"
        ;;
        -s|--src)
        SRC_BRANCH="$2"
        shift
        ;;
        -d|--deploy)
        DEPLOY_BRANCH="$2"
        shift
        ;;
        --verbose)
        set -x
        ;;
        --no-push)
        NO_PUSH="true"
        ;;
        *)
        echo "Option $1 is unknown." >&2
        echo "$USAGE_MSG" >&2
        exit 1
        ;;
    esac
    shift
done

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

source_worktree=""
deploy_worktree=""
preserve_dir=""

cleanup() {
    if [[ -n "$source_worktree" ]]; then
        git worktree remove --force "$source_worktree" >/dev/null 2>&1 || rm -rf "$source_worktree"
    fi
    if [[ -n "$deploy_worktree" ]]; then
        git worktree remove --force "$deploy_worktree" >/dev/null 2>&1 || rm -rf "$deploy_worktree"
    fi
    if [[ -n "$preserve_dir" ]]; then
        rm -rf "$preserve_dir"
    fi
}
trap cleanup EXIT

echo "Deploying..."
echo "Source branch: $SRC_BRANCH"
echo "Deploy branch: $DEPLOY_BRANCH"

read -r -p "Do you want to proceed? [y/N] " response
if [[ ! "$response" =~ ^([yY][eE][sS]|[yY])+$ ]]; then
    echo "Aborting."
    exit 1
fi

if ! git diff-index --quiet HEAD --; then
    echo "Changes to the following files are uncommitted:"
    git diff-index --name-only HEAD --
    echo "Please commit the changes before proceeding."
    echo "Aborting."
    exit 1
fi

if [[ -n "$(git ls-files --exclude-standard --others)" ]]; then
    echo "There are untracked files:"
    git ls-files --exclude-standard --others
    echo "Please commit those files or stash them before proceeding."
    echo "Aborting."
    exit 1
fi

if ! git rev-parse --verify --quiet "refs/heads/$SRC_BRANCH" >/dev/null; then
    git branch "$SRC_BRANCH" HEAD
fi

source_worktree="$(mktemp -d)"
rmdir "$source_worktree"
git worktree add --detach "$source_worktree" "$SRC_BRANCH"

echo "Building site..."
(
    cd "$source_worktree"
    bundle exec jekyll build
)

deploy_base="$SRC_BRANCH"
if git rev-parse --verify --quiet "refs/heads/$DEPLOY_BRANCH" >/dev/null; then
    deploy_base="$DEPLOY_BRANCH"
fi

deploy_worktree="$(mktemp -d)"
rmdir "$deploy_worktree"
git worktree add --detach "$deploy_worktree" "$deploy_base"

preserve_dir="$(mktemp -d)"
for preserved_file in CNAME .gitignore; do
    if [[ -f "$deploy_worktree/$preserved_file" ]]; then
        cp "$deploy_worktree/$preserved_file" "$preserve_dir/$preserved_file"
    fi
done

if git rev-parse --verify --quiet "refs/heads/$DEPLOY_BRANCH" >/dev/null; then
    git branch -D "$DEPLOY_BRANCH"
fi

(
    cd "$deploy_worktree"
    git checkout -b "$DEPLOY_BRANCH"

    find . -mindepth 1 -maxdepth 1 ! -name ".git" -exec rm -rf {} +

    for preserved_file in CNAME .gitignore; do
        if [[ -f "$preserve_dir/$preserved_file" ]]; then
            cp "$preserve_dir/$preserved_file" "$preserved_file"
        fi
    done

    tar -C "$source_worktree/_site" -cf - . | tar -xf -

    git add -fA
    git commit --allow-empty -m "$(git -C "$source_worktree" log -1 --pretty=%B) [ci skip]"

    if [[ -z "$NO_PUSH" ]]; then
        git push -f -q origin "$DEPLOY_BRANCH"
    fi
)

echo "Deployed successfully!"
